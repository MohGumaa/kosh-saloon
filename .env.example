# Copy to .env and fill in real values. Never commit .env.
# Names use the `kosh_` prefix that the Vercel Prisma Postgres integration injects.

# Direct PostgreSQL connection string used by Prisma (pg driver adapter).
kosh_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Absolute base URL used in email links (password reset, login notifications).
APP_URL="http://localhost:3000"

# Resend API key and sender. Without a key, development logs emails to the
# server console; production logs an error and sends nothing.
EMAIL_API_KEY=""
EMAIL_FROM="Kosh CRM <no-reply@example.com>"

# First admin, created by `pnpm exec prisma db seed` only when no ADMIN exists.
# Password: 8-128 characters. Remove these after seeding.
SEED_ADMIN_NAME=""
SEED_ADMIN_USERNAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
